{
  "manifest_version": 3,
  "name": "itsdeepfake",
  "version": "1.0",
  "description": "Quickly record your screen and analyze for deepfakes on the spot.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Launch itsdeepfake"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ]
}
